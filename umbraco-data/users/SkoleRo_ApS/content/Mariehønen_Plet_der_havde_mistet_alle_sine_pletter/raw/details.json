        "id": 2036300,
        "dataTypeId": "0cc0eba1-9960-42c9-bf9b-60e150b429ae",
        "value": "Mariehønen Plet der havde mistet alle sine pletter",
        "alias": "title",
        "editor": "Umbraco.Textbox",
